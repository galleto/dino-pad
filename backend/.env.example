# ============================================================
# .env.example - Plantilla de variables de entorno para backend
# NO coloques contraseñas ni secretos reales en este archivo.
# ============================================================

NODE_ENV=development

# Base de datos (TimescaleDB / PostgreSQL)
# Puedes usar TIMESCALE_SERVICE_URL o DATABASE_URL
DATABASE_URL=postgres://tsdbadmin:password@host:39481/tsdb?sslmode=require
TIMESCALE_SERVICE_URL=postgres://tsdbadmin:password@host:39481/tsdb?sslmode=require

# Google Gemini API
GEMINI_APIKEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# MQTT Broker (Dinopad IoT)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=false

